# Copy to .env and adjust if needed. .env is git-ignored.
#   cp .env.example .env

# Mongo database name used by the backend.
MONGO_DB=clinic

# --- Keycloak (shared infra) ---------------------------------------------
# This project has no Keycloak of its own — it shares the instance the
# sibling fanvote project runs (docker compose up in ../fanvote), using a
# separate "clinic" realm/"frontend" client imported into it. Point these at
# wherever that Keycloak is reachable from:
#
#   - the backend container (issuer-uri; on the same Docker host this is
#     usually http://host.docker.internal:8080/realms/clinic on
#     Windows/macOS, or the fanvote network's keycloak service name if this
#     compose file is ever attached to it)
#   - the browser (frontend build args; almost always http://localhost:8080)
#
# Leave unset to run this stack with auth effectively unconfigured: the
# public pages (/, /services) still work, but /book, /account and /admin will
# fail to validate tokens against a realm that doesn't exist there.
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/clinic
FRONTEND_KEYCLOAK_URL=http://localhost:8080

# CORS — must match wherever the frontend is actually served from.
CORS_ALLOWED_ORIGIN=http://localhost:4201

# Where the frontend's build-time API_URL placeholder points — the browser's
# view of the backend, not the Docker-internal one.
FRONTEND_API_URL=http://localhost:8081
